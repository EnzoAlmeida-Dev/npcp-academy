# Variaveis publicas (expostas ao cliente). Nunca coloque segredos aqui.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=cole-a-chave-publicavel-local

# Variaveis exclusivas de servidor. NUNCA usar prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-apenas-no-servidor

# Configuracao da aplicacao
INVITE_TTL_DAYS=7
# Deve estar na allowlist de redirects do Supabase (config.toml [auth]).
APP_URL=http://127.0.0.1:3000
