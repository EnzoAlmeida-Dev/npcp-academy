# Ambientes:
# - `.env.local`          -> alvo ativo (nuvem ou local). Use para nuvem/Vercel.
# - `.env.development.local` -> override opcional do Supabase local (Docker).
#   O `npm run dev` usa o local se ele estiver acessivel; senao cai para `.env.local`.

# Variaveis publicas (expostas ao cliente). Nunca coloque segredos aqui.
# Local (Supabase CLI): valor vem de `supabase status`.
# Nuvem: Project Settings > API no dashboard do Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=cole-a-chave-publicavel

# Variaveis exclusivas de servidor. NUNCA usar prefixo NEXT_PUBLIC_.
# Necessaria apenas para o bootstrap do primeiro gerente (seed:manager).
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-apenas-no-servidor

# Configuracao da aplicacao
INVITE_TTL_DAYS=7
# URL publica do app (deve estar na allowlist de redirects do Supabase).
# Local: http://127.0.0.1:3000
# Vercel: https://<seu-projeto>.vercel.app (ou dominio customizado).
# Se omitida no Vercel, o app usa VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL.
APP_URL=http://127.0.0.1:3000
